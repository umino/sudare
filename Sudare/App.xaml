<Application x:Class="Sudare.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:v="clr-namespace:Sudare.Views">
    <Application.Resources>
        <ResourceDictionary>
            <v:EnumBooleanConverter x:Key="EnumBool" />
            <v:WordWrapToScrollBarConverter x:Key="WrapToScroll" />
            <v:InverseBooleanConverter x:Key="InverseBool" />
            <v:NullToVisibilityConverter x:Key="NullToVisibility" />
            <v:NullToVisibleConverter x:Key="NullToVisible" />
            <v:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
            <v:NullToBooleanConverter x:Key="NullToBool" />
            <v:RowBackgroundConverter x:Key="RowBackground" />
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- メニュー項目の横に出す色見本 -->
            <Style x:Key="MenuSwatch" TargetType="Border">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="14" />
                <Setter Property="CornerRadius" Value="2" />
                <Setter Property="BorderBrush" Value="#FFB0B0B0" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!--
                操作バーの「なし / 一致箇所 / 行全体」のような、地続きに並べる選択肢。
                ラジオボタンの丸を消して、押せる帯として見せる。
            -->
            <Style x:Key="BarSegment" TargetType="RadioButton">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="RadioButton">
                            <Border x:Name="Bd" Background="Transparent" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FF4A90D9" />
                                    <Setter Property="Foreground" Value="White" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsChecked" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#FFE8F0F8" />
                                </MultiTrigger>
                                <!-- キーボードで来たときも、どこにいるか分かるようにする -->
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#FF1B3D5C" />
                                    <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="SectionHeader" TargetType="TextBlock">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Margin" Value="0,0,0,2" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="PatternBox" TargetType="TextBox">
                <Setter Property="AcceptsReturn" Value="True" />
                <Setter Property="AcceptsTab" Value="False" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
                <Setter Property="FontFamily" Value="Consolas, MS Gothic" />
                <Setter Property="SpellCheck.IsEnabled" Value="False" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
            </Style>

            <!--
                「含む」1 行分の ON/OFF。チェック欄そのものをその行の強調色で塗ることで、
                どのパターンがログ本文のどの色に対応しているかを一目で分かるようにする。
            -->
            <Style x:Key="PatternToggle" TargetType="CheckBox">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="CheckBox">
                            <!-- 色が付いていない行でも当たり判定が要るので、Background は白にする -->
                            <Border x:Name="Box" Width="16" Height="16" CornerRadius="3"
                                    Margin="1,0,4,0"
                                    BorderBrush="#FFB0B0B0" BorderThickness="1"
                                    Background="{Binding Color, TargetNullValue=White}"
                                    SnapsToDevicePixels="True">
                                <Path x:Name="Check" Visibility="Collapsed"
                                      Data="M 3,7.5 L 6,11 L 12,3"
                                      Stroke="#FF3A3A3A" StrokeThickness="1.8"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      StrokeLineJoin="Round" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#FF8A8A8A" />
                                </Trigger>
                                <!-- 末尾の入力用の空行は、まだ何も指定していないので印を出さない -->
                                <DataTrigger Binding="{Binding Text}" Value="">
                                    <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#FFD0D0D0" />
                                    <!-- パターンが無いと色を付ける先が無いので、色のメニューも出さない -->
                                    <Setter Property="ContextMenuService.IsEnabled" Value="False" />
                                </DataTrigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#FF4A90D9" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Box" Property="BorderBrush" Value="#FF4A90D9" />
                                    <Setter TargetName="Box" Property="BorderThickness" Value="2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 「含む」リストの 1 行: [色付きチェック] [パターン] [削除] -->
            <DataTemplate x:Key="PatternLineTemplate">
                <Grid Margin="3,1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <CheckBox Grid.Column="0" Style="{StaticResource PatternToggle}"
                              IsChecked="{Binding IsEnabled}"
                              ToolTip="この行を抽出条件として使うかどうか。色はログ本文の強調色と同じです。右クリックで色を変えられます。">
                        <!--
                            色見本を右クリックして色を選ぶ。チェックが付くのは自分で選んだ色だけで、
                            何も選んでいなければ「自動（並び順）」に付く。
                        -->
                        <CheckBox.ContextMenu>
                            <ContextMenu>
                                <ContextMenu.Resources>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Command" Value="{Binding ChooseColorCommand}" />
                                    </Style>
                                </ContextMenu.Resources>
                                <MenuItem Header="黄" CommandParameter="0"
                                          IsChecked="{Binding ChosenColorIndex, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=0}">
                                    <MenuItem.Icon>
                                        <Border Style="{StaticResource MenuSwatch}"
                                                Background="{Binding Source={x:Static v:HighlightRuleSet.Palette}, Path=[0]}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="緑" CommandParameter="1"
                                          IsChecked="{Binding ChosenColorIndex, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=1}">
                                    <MenuItem.Icon>
                                        <Border Style="{StaticResource MenuSwatch}"
                                                Background="{Binding Source={x:Static v:HighlightRuleSet.Palette}, Path=[1]}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="青" CommandParameter="2"
                                          IsChecked="{Binding ChosenColorIndex, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=2}">
                                    <MenuItem.Icon>
                                        <Border Style="{StaticResource MenuSwatch}"
                                                Background="{Binding Source={x:Static v:HighlightRuleSet.Palette}, Path=[2]}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="橙" CommandParameter="3"
                                          IsChecked="{Binding ChosenColorIndex, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=3}">
                                    <MenuItem.Icon>
                                        <Border Style="{StaticResource MenuSwatch}"
                                                Background="{Binding Source={x:Static v:HighlightRuleSet.Palette}, Path=[3]}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="紫" CommandParameter="4"
                                          IsChecked="{Binding ChosenColorIndex, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=4}">
                                    <MenuItem.Icon>
                                        <Border Style="{StaticResource MenuSwatch}"
                                                Background="{Binding Source={x:Static v:HighlightRuleSet.Palette}, Path=[4]}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="水色" CommandParameter="5"
                                          IsChecked="{Binding ChosenColorIndex, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=5}">
                                    <MenuItem.Icon>
                                        <Border Style="{StaticResource MenuSwatch}"
                                                Background="{Binding Source={x:Static v:HighlightRuleSet.Palette}, Path=[5]}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="桃" CommandParameter="6"
                                          IsChecked="{Binding ChosenColorIndex, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=6}">
                                    <MenuItem.Icon>
                                        <Border Style="{StaticResource MenuSwatch}"
                                                Background="{Binding Source={x:Static v:HighlightRuleSet.Palette}, Path=[6]}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Header="黄緑" CommandParameter="7"
                                          IsChecked="{Binding ChosenColorIndex, Mode=OneWay, Converter={StaticResource EnumBool}, ConverterParameter=7}">
                                    <MenuItem.Icon>
                                        <Border Style="{StaticResource MenuSwatch}"
                                                Background="{Binding Source={x:Static v:HighlightRuleSet.Palette}, Path=[7]}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem Header="自動（並び順）"
                                          IsChecked="{Binding ChosenColorIndex, Mode=OneWay, Converter={StaticResource NullToBool}}"
                                          ToolTip="選んだ色を解除し、並び順で決まる色に戻します" />
                            </ContextMenu>
                        </CheckBox.ContextMenu>
                    </CheckBox>

                    <Grid Grid.Column="1">
                        <TextBox Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" Padding="1,1"
                                 FontFamily="Consolas, MS Gothic"
                                 SpellCheck.IsEnabled="False">
                            <TextBox.Style>
                                <Style TargetType="TextBox">
                                    <Style.Triggers>
                                        <!-- OFF の行は文言を残したまま、効いていないことを見て分かるようにする -->
                                        <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                            <Setter Property="Foreground" Value="#FFA0A0A0" />
                                            <Setter Property="FontStyle" Value="Italic" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                        <TextBlock Text="パターンを入力（1 行に 1 つ）" Margin="3,1,0,0"
                                   IsHitTestVisible="False" Foreground="#FFBDBDBD" FontSize="11"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding Text, Converter={StaticResource NullToVisible}}" />
                    </Grid>

                    <Button Grid.Column="2" Content="✕" Width="18" Padding="0" Margin="2,0,0,0"
                            BorderThickness="0" Background="Transparent" Foreground="#FF9E9E9E"
                            ToolTip="この行を削除"
                            Command="{Binding DataContext.RemovePatternCommand,
                                              RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}" />
                </Grid>
            </DataTemplate>

            <!-- 100 万行を並べるので、行コンテナは可能な限り軽くする -->
            <Style x:Key="LineItemStyle" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    Padding="2,0,2,0"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Left" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#FFCDE4F7" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="IsMouseOver" Value="True" />
                                        <Condition Property="IsSelected" Value="False" />
                                    </MultiTrigger.Conditions>
                                    <Setter TargetName="Bd" Property="Background" Value="#FFF0F0F0" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <!--
                    行全体の背景。
                      「行全体に色を付ける」で一致した行 … その「含む」の色
                      マーカーの付いた行 … 横スクロールで左端の帯が見えなくなっても分かるよう、マーカーの色で淡く塗る
                      どちらでもない行 … Transparent（＝既定の背景）
                    強調ルールが差し替わると Tag.Highlight が変わるので、実体化済みの行も塗り直される。
                -->
                <Setter Property="Background">
                    <Setter.Value>
                        <MultiBinding Converter="{StaticResource RowBackground}">
                            <Binding Path="Text" />
                            <Binding Path="Tag.Highlight" RelativeSource="{RelativeSource AncestorType=ListBox}" />
                            <Binding Path="MarkerRowBrush" />
                        </MultiBinding>
                    </Setter.Value>
                </Setter>
            </Style>

            <DataTemplate x:Key="LineTemplate">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- マーカー帯 4px + 余白 5px。列幅が帯とマージンの合計より狭いと帯が潰れる -->
                        <ColumnDefinition Width="9" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- マーカーの目印。色は行ごとに選べる -->
                    <Border Grid.Column="0" Width="4" HorizontalAlignment="Left" CornerRadius="2"
                            Background="{Binding MarkerAccentBrush, TargetNullValue=Transparent}" />

                    <TextBlock Grid.Column="1"
                               Text="{Binding LineNumberText}"
                               Width="{Binding Tag.LineNumberWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               Visibility="{Binding Tag.LineNumberVisibility, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               TextAlignment="Right"
                               VerticalAlignment="Top"
                               Margin="0,0,8,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground"
                                        Value="{Binding MarkerNumberBrush, TargetNullValue=#FF8A8A8A}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMarked}" Value="True">
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>

                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Top"
                               TextWrapping="{Binding Tag.TextWrapping, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               MinWidth="{Binding Tag.ContentMinWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                               v:TextHighlighter.SourceText="{Binding Text}"
                               v:TextHighlighter.Rules="{Binding Tag.Highlight, RelativeSource={RelativeSource AncestorType=ListBox}}">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <!-- 条件に一致した行ではなく、前後の文脈として出ている行は淡く表示する -->
                                    <DataTrigger Binding="{Binding IsContext}" Value="True">
                                        <Setter Property="Foreground" Value="#FF9E9E9E" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
